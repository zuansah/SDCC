rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin';
    }
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }
    match /deleted_users/{document=**} {
      allow read, write: if isSuperAdmin();
    }
    match /auth_vault/{document=**} {
      allow read, write: if isSuperAdmin();
    }
    match /assurance_tickets/{document=**} {
      allow read, write: if true;
    }
    match /assurance/{document=**} {
      allow read: if true;
    }
    match /assets/{document=**} {
      allow read, write: if true;
    }
    match /asset_edits/{document=**} {
      allow read, write: if true;
    }
    match /controllers/{document=**} {
      allow read: if true;
    }
    match /bas/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /traceMappings/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /orders/{document=**} {
      allow read: if isSignedIn();
    }
    match /tasks/{document=**} {
      allow read, write: if isSignedIn();
    }
    match /user_sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }
    match /access_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }
  }
}
